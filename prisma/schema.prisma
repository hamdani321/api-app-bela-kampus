// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model mahasiswa {
  id Int @id
  nama String @db.VarChar(100)
  email String @db.VarChar(100) @unique
  nim String  @db.VarChar(100) @unique
  kode_prodi Int
  kelas_id Int
  jenis_kelamin JenisKelamin
  createdAt DateTime?
  updatedAt DateTime?
  kelas kelas @relation(fields: [kelas_id], references: [id])
  prodi prodi @relation(fields: [kode_prodi], references: [kode_prodi])
  registrasi_anggota registrasi_anggota[]
  registrasi registrasi[]
  user users?
  @@map("mahasiswa")
}

enum StatusPortal {
  AKTIF
  NONAKTIF
}

model portal {
  id Int @id
  tahun_ajaran_id Int
  waktu_mulai DateTime
  waktu_selesai DateTime
  status StatusPortal
  createdAt DateTime?
  updatedAt DateTime?
  registrasi registrasi[]
  tahun_ajaran tahun_ajaran @relation(fields: [tahun_ajaran_id], references: [id])

  @@map("portal")
}

model kelas {
  id Int @id
  nama String @db.VarChar(100)
  prodi_id String @db.VarChar(100)
  dosen_id String @db.VarChar(100)
  createdAt DateTime?
  updatedAt DateTime?
  mahasiswa mahasiswa[]
  @@map("kelas")
}

model prodi {
  id Int @id
  kode_prodi Int @unique
  nama String @db.VarChar(100)
  singkatan String @db.VarChar(100)
  jenjang String @db.VarChar(100)
  kaprodi String @db.VarChar(100)
  createdAt DateTime?
  updatedAt DateTime?
  mahasiswa mahasiswa[]
  @@map("prodi")
}

enum RegistrasiTipe {
  INDIVIDU
  KELOMPOK
}

enum RegistrasiStatus {
  Pending
  Approve
}

model registrasi {
  id Int @id @default(autoincrement())
  portal_id Int
  sekolah_id Int
  nim_mahasiswa String
  tipe RegistrasiTipe
  status RegistrasiStatus
  createdAt DateTime?
  updatedAt DateTime?
  registrasi_anggota registrasi_anggota[]
  portal portal @relation(fields: [portal_id], references: [id])

  mahasiswa mahasiswa @relation(fields: [nim_mahasiswa], references: [nim])
  sekolah sekolah @relation(fields: [sekolah_id], references: [id])

  @@map("registrasi")
}

model registrasi_anggota {
  id Int @id @default(autoincrement())
  registrasi_id Int
  portal_id Int
  nim_mahasiswa String
  createdAt DateTime?
  updatedAt DateTime?
  registrasi registrasi @relation(fields: [registrasi_id], references: [id])
  mahasiswa mahasiswa @relation(fields: [nim_mahasiswa], references: [nim])
  @@map("registrasi_anggota")
}

model report_kegiatan {
  id Int @id
  registrasi_id Int
  nim_mahasiswa String
  nama_pic String @db.VarChar(100)
  nomor_hp_pic String @db.VarChar(100)
  foto String @db.VarChar(100)
  video String @db.VarChar(100)
  deskripsi String @db.Text()
  createdAt DateTime?
  updatedAt DateTime?
  @@map("report_kegiatan")
}

model sekolah {
  id Int @id @default(autoincrement())
  npsn String @db.VarChar(100) @unique
  nama String @db.VarChar(100)
  email String @db.VarChar(100) @unique
  alamat String @db.VarChar(100)
  telepon String @db.VarChar(100)
  latitude String @db.VarChar(100)
  longitude String @db.VarChar(100)
  namaKepsek String? @db.VarChar(100)
  createdAt DateTime?
  updatedAt DateTime?

  registrasi registrasi[]
  @@map("sekolah")
}

enum TahunAjaranJenis {
  Ganjil
  Genap
}
model tahun_ajaran {
  id Int @id
  nama String @db.VarChar(100)
  tahun Int @default(0)
  jenis TahunAjaranJenis
  createdAt DateTime?
  updatedAt DateTime?

  //relasi
  portal portal[]
}

model users {
 id Int @id
 name String @db.VarChar(100)
 email String @db.VarChar(100) @unique
 password String @db.VarChar(100)
 roles role_users[]
 mahasiswa mahasiswa @relation(fields: [email], references: [email])
}

enum Roles {
  ADMIN
  MAHASISWA
}
model role_users {
  id Int @id
  user_id Int
  role Roles
  user users @relation(fields: [user_id], references: [id])
}